# =========================================================================
# PDB Homes: Environment Configuration
# =========================================================================

# 1. Supabase Cloud Database (Recommended)
# Create a free project at https://supabase.com, run db/supabase_schema.sql in SQL Editor
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 2. Optional Direct PostgreSQL Connection
# DATABASE_URL=postgresql://postgres:password@localhost:5432/pdbhomes

# 3. Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
