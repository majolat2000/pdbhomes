# =========================================================================
# PDB Homes: Environment Configuration
# =========================================================================

# 1. Supabase Cloud Database (Recommended)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 2. Application URL
NEXT_PUBLIC_APP_URL=https://pdbhomes.com.ng
NODE_ENV=production

# 3. Paystack Payment Gateway Integration
PAYSTACK_SECRET_KEY=your_paystack_secret_key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# 4. Email Notifications (Optional: Resend or SMTP)
# RESEND_API_KEY=re_xxxxxxxxx
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=info@pdbhomes.com.ng
# SMTP_PASS=your-password
